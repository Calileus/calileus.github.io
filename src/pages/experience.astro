---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Experience | Calileus" description="Impact metrics and professional experience timeline for Calileus." lang="en">
  <section class="section-band section-intro border-t-0">
    <p class="eyebrow">Experience</p>
    <h1>Technical leadership from architecture to production.</h1>
    <p>I lead engineering systems end-to-end: architecture, quality automation, release governance, and team enablement.</p>
  </section>

  <section class="section-band">
    <div class="grid-3">
      <article class="impact-item"><strong>60%</strong><span>Review effort reduction via 10+ GitHub Actions workflows across 8 components.</span></article>
      <article class="impact-item"><strong>100%</strong><span>First-pass execution success improved from roughly 20% to near full reliability.</span></article>
      <article class="impact-item"><strong>2,538</strong><span>Commits and 280+ reviews as a primary repository maintainer.</span></article>
    </div>
  </section>

  <section class="section-band">
    <div class="space-y-10">
      <article class="experience-item">
        <div class="experience-date">APR 2022 — PRESENT</div>
        <div>
          <h3>Software Architect & Lead Developer</h3>
          <p class="mt-1 text-emerald-400">AUMOVIO / Continental Autonomous Mobility</p>
          <ul>
            <li>Led a 14-person multidisciplinary team for automotive radar logic model delivery.</li>
            <li>Architected processing pipelines with protobuf interfaces and FMI integration.</li>
            <li>Defined cross-platform governance, branching, versioning, and release practices.</li>
          </ul>
        </div>
      </article>

      <article class="experience-item">
        <div class="experience-date">2015 — 2022</div>
        <div>
          <h3>University Professor & Academic Manager</h3>
          <p class="mt-1 text-emerald-400">Polytechnic University of Querétaro / Autonomous University of Querétaro</p>
          <ul>
            <li>Taught C/C++ programming, mathematics, and formal logic.</li>
            <li>Developed automated grading and contest tooling for scalable assessments.</li>
          </ul>
        </div>
      </article>

      <article class="experience-item">
        <div class="experience-date">2014 — 2016</div>
        <div>
          <h3>Software Development Consultant</h3>
          <p class="mt-1 text-emerald-400">REXAM · IMPULSE TELECOM · Sancorzep Group · REGULES</p>
          <ul>
            <li>Delivered enterprise software solutions using SQL, C++, and WinAPI technologies.</li>
            <li>Managed requirements, implementation, deployment, and post-release support.</li>
          </ul>
        </div>
      </article>
    </div>
  </section>
</Layout>
---
import Layout from "../layouts/Layout.astro";
import { experience, testimonials } from "../data/portfolio";
---

<Layout title="Experience | Calileus" description="C++ software architecture, team leadership, teaching, and consulting experience." path="/experience">
  <main>
    <section class="page-intro page-intro--profile mx-auto max-w-6xl px-6 py-24" aria-labelledby="experience-heading"><div><p class="eyebrow">EXPERIENCE</p><h1 id="experience-heading">I build software and help teams do their best work.</h1><p>My background spans automotive software, teaching, and consulting.</p></div><figure class="profile-portrait"><img src="/profile_real_photo.jpg" alt="Portrait of Calileus" /><figcaption>Calileus · Querétaro, Mexico</figcaption></figure></section>
    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="timeline-heading">
      <div class="section-intro"><p class="eyebrow">01 / TIMELINE</p><h2 id="timeline-heading">Where I have worked.</h2><p>Automotive software, education, and business systems.</p></div>
      <div class="experience-list">{experience.map((role) => <article class:list={["experience-item", { "experience-item--current": role.current }]}><div class="experience-date">{role.period}</div><div><div class="experience-role"><h3>{role.role}</h3>{role.current && <span class="experience-current">CURRENT</span>}</div><p class="experience-company">{role.company}</p><ul>{role.highlights.map((highlight) => <li>{highlight}</li>)}</ul></div></article>)}</div>
    </section>
    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="endorsements-heading">
      <div class="section-intro"><p class="eyebrow">02 / WHAT PEOPLE SAY</p><h2 id="endorsements-heading">Feedback from colleagues.</h2><p>Words from people I have worked with.</p></div>
      <div class="testimonials-grid">{testimonials.map((testimonial) => <article class="testimonial-card"><div class="testimonial-quote">&quot;{testimonial.quote}&quot;</div><div class="testimonial-author"><div class="testimonial-name">{testimonial.name}</div><div class="testimonial-title">{testimonial.title}</div><div class="testimonial-location">{testimonial.location}</div></div></article>)}</div>
    </section>
  </main>
</Layout>
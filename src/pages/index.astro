        </div>
        <div class="cert-card">
          <div class="cert-year">2024</div>
          <h3>EF SET English Certificate</h3>
          <p class="cert-issuer">EF Education First</p>
          <p class="cert-desc">C1 Advanced proficiency supporting international team collaboration and technical communication.</p>
        </div>

---
import Layout from "../layouts/Layout.astro";
import { metrics } from "../data/portfolio";
---

<Layout title="Calileus | Software Architect & Lead Developer" path="/">
  <main id="top">
    <section class="hero-section mx-auto max-w-6xl px-6" aria-labelledby="hero-heading">
      <div class="hero-grid-pattern" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Software architect · hands-on engineer</p>
        <h1 id="hero-heading">I help teams make <span class="gradient-text">complex software</span> easier to change.</h1>
        <p class="hero-lede">My work is mostly C++ systems and automotive perception software. I like staying close to the code, making decisions understandable, and learning from the people around me.</p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/experience" class="btn-primary">Experience <span aria-hidden="true">↓</span></a>
          <a href="/projects" class="btn-secondary">Selected work <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-meta"><span class="meta-divider"></span><span>M.Sc. Mathematics · Querétaro, Mexico</span><span class="meta-divider"></span></div>
      </div>
      <aside class="hero-visual" aria-label="Calileus engineering identity">
        <div class="hero-visual__frame">
          <img src="/chibi_modern_profile_pic.png" alt="Illustrated portrait of Calileus programming with a Charmander companion" />
          <div class="hero-visual__scanline" aria-hidden="true"></div>
          <div class="hero-visual__label hero-visual__label--top">C++ · AUTOMOTIVE SOFTWARE</div>
          <div class="hero-visual__label hero-visual__label--bottom"><span class="status-dot"></span>MÉXICO</div>
        </div>
        <div class="hero-visual__caption"><span>Building software with teams</span><strong>Learn · Build · Improve</strong></div>
      </aside>
    </section>

    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="impact-heading">
      <div class="section-intro"><p class="eyebrow">01 / AT A GLANCE</p><h2 id="impact-heading">A little context.</h2><p>Milestones from work I have been part of.</p></div>
      <div class="impact-grid">
        {metrics.map((metric, index) => <div class:list={["impact-item", { "impact-item--featured": index === 0 }]}><strong>{metric.value}</strong><span>{metric.description}</span></div>)}
      </div>
    </section>

    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="nav-heading">
      <div class="section-intro"><p class="eyebrow">02 / EXPLORE</p><h2 id="nav-heading">More about my work.</h2></div>
      <nav class="nav-grid" aria-label="Main navigation">
        <a href="/experience" class="nav-card">
          <h3>Experience</h3>
          <p>Automotive software, teaching, and private prototypes</p>
        </a>
        <a href="/projects" class="nav-card">
          <h3>Projects</h3>
          <p>Upstream contributions and collaborative projects</p>
        </a>
        <a href="/architecture" class="nav-card">
          <h3>Architecture</h3>
          <p>How I make technical decisions and work with teams</p>
        </a>
        <a href="/credentials" class="nav-card">
          <h3>Credentials</h3>
          <p>AI, security, parallel computing, language certs</p>
        </a>
      </nav>
    </section>

    <section class="closing-section mx-auto max-w-6xl px-6" aria-labelledby="contact-heading">
      <div class="closing-panel"><p class="eyebrow">03 / CONNECT</p><h2 id="contact-heading">Have a problem worth working through?</h2><p>I’m always glad to hear about thoughtful software teams and difficult engineering problems.</p><div class="mt-6 flex flex-wrap gap-4"><a href="https://www.linkedin.com/in/calileus" target="_blank" rel="noopener noreferrer" class="btn-primary">Contact on LinkedIn <span aria-hidden="true">↗</span></a><a href="https://github.com/Calileus" target="_blank" rel="noopener noreferrer" class="btn-secondary">GitHub <span aria-hidden="true">↗</span></a></div></div>
    </section>
  </main>
</Layout>
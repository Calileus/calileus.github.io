---
import Layout from "../layouts/Layout.astro";
import { credentials } from "../data/portfolio";
---

<Layout title="Education | Calileus" description="Mathematics education and recent technical courses completed by Calileus." path="/credentials">
  <main>
    <section class="page-intro mx-auto max-w-6xl px-6 py-24" aria-labelledby="credentials-heading"><p class="eyebrow">EDUCATION</p><h1 id="credentials-heading">What I studied and what I keep learning.</h1><p>A mathematics degree, plus recent courses in software and computing.</p></section>
    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="education-heading"><div class="section-intro"><p class="eyebrow">01 / DEGREE</p><h2 id="education-heading">Mathematics</h2></div><article class="philosophy-panel"><p><strong>Master of Science in Mathematics</strong></p><p>Mathematics taught me to break down difficult problems and explain the reasoning clearly.</p></article></section>
    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="certifications-heading"><div class="section-intro"><p class="eyebrow">02 / COURSES</p><h2 id="certifications-heading">Recent learning.</h2><p>Courses that support my day-to-day work.</p></div><div class="certs-grid">{credentials.map((credential) => <article class="cert-card"><div class="cert-year">{credential.year}</div><h3>{credential.name}</h3><p class="cert-issuer">{credential.issuer}</p><p class="cert-desc">{credential.description}</p></article>)}</div></section>
  </main>
</Layout>
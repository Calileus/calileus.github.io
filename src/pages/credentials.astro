---
import Layout from "../layouts/Layout.astro";
import { credentials } from "../data/portfolio";
---

<Layout title="Credentials | Calileus" description="Mathematics education and continuing technical credentials in secure software design, CUDA, and AI." path="/credentials">
  <main>
    <section class="page-intro mx-auto max-w-6xl px-6 py-24" aria-labelledby="credentials-heading"><p class="eyebrow">CREDENTIALS</p><h1 id="credentials-heading">Formal reasoning, continuous learning.</h1><p>Academic foundations in mathematics and targeted learning in the engineering domains shaping modern software systems.</p></section>
    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="education-heading"><div class="section-intro"><p class="eyebrow">01 / EDUCATION</p><h2 id="education-heading">Mathematics as an engineering foundation.</h2></div><article class="philosophy-panel"><p><strong>Master of Science in Mathematics</strong></p><p>Academic study in mathematical reasoning supports the analytical discipline applied to architecture, formal logic, and complex technical systems.</p></article></section>
    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="certifications-heading"><div class="section-intro"><p class="eyebrow">02 / CERTIFICATIONS</p><h2 id="certifications-heading">Current technical practice.</h2><p>Focused credentials that complement practical work in dependable software systems.</p></div><div class="certs-grid">{credentials.map((credential) => <article class="cert-card"><div class="cert-year">{credential.year}</div><h3>{credential.name}</h3><p class="cert-issuer">{credential.issuer}</p><p class="cert-desc">{credential.description}</p></article>)}</div></section>
  </main>
</Layout>
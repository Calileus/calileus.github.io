---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "es";
}

const {
  title,
  description = "Calileus - Software Architect & Lead Developer. Modern C++, quality engineering, delivery leadership, and systems architecture."
} = Astro.props;
const lang = Astro.props.lang ?? "en";

const pathname = Astro.url.pathname;
const prefix = lang === "es" ? "/es" : "";
const links = [
  { href: `${prefix}/`, label: lang === "es" ? "Inicio" : "Home" },
  { href: `${prefix}/about`, label: lang === "es" ? "Perfil" : "About" },
  { href: `${prefix}/experience`, label: lang === "es" ? "Experiencia" : "Experience" },
  { href: `${prefix}/projects`, label: lang === "es" ? "Proyectos" : "Projects" },
  { href: `${prefix}/contact`, label: lang === "es" ? "Contacto" : "Contact" }
];

const switchLabel = lang === "es" ? "EN" : "ES";
let switchHref = "/es/";
if (lang === "en") {
  switchHref = pathname === "/" ? "/es/" : `/es${pathname}`;
} else {
  const normalized = pathname.replace(/^\/es/, "");
  switchHref = normalized.length > 0 ? normalized : "/";
}

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#064e3b" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://calileus.github.io${pathname}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://calileus.github.io/og-image.svg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://calileus.github.io/og-image.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = saved === "light" || saved === "dark" ? saved : (systemPrefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="antialiased bg-neutral-950 text-neutral-200">
    <header class="site-header">
      <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-20">
        <a href={prefix.length > 0 ? `${prefix}/` : "/"} class="brand-mark" aria-label="Calileus home">
          <span class="brand-mark__dot"></span>
          <span>Calileus<span class="text-brand-400">.</span></span>
        </a>
        <div class="header-controls">
          <nav class="hidden md:flex items-center gap-6 text-sm text-surface-400" aria-label="Main navigation">
            {links.map((link) => (
              <a href={link.href} class={isActive(link.href) ? "nav-link nav-link--active" : "nav-link"}>{link.label}</a>
            ))}
          </nav>
          <a href={switchHref} class="lang-switch" aria-label={lang === "es" ? "Cambiar a inglés" : "Switch to Spanish"}>{switchLabel}</a>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label={lang === "es" ? "Cambiar tema" : "Switch theme"} aria-pressed="false">
            <span id="theme-toggle-icon" aria-hidden="true">◐</span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="max-w-6xl mx-auto px-6 py-8 footer-line">
      <span>© {new Date().getFullYear()} Calileus</span>
      <span>Built with Astro · Deployed on GitHub Pages</span>
    </footer>
    <script src="/theme.js" defer></script>
  </body>
</html>